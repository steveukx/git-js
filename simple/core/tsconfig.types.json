{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "composite": false,
    "isolatedDeclarations": true,
    "verbatimModuleSyntax": true
  },
  "include": ["index.ts", "src"],
  "exclude": ["node_modules", "test"]
}

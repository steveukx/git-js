{
  "name": "@simple-git/repo",
  "version": "3.1.1",
  "private": true,
  "resolutions": {
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:pkg": "pnpm -r run build:pkg",
    "build:pkg:reset": "tsx ./devtools/reset-package-json",
    "clean": "git clean -fxd -e node_modules simple-git packages",
    "clean:cache": "git clean -fxd node_modules simple-git packages",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "pnpm -r run test",
    "test:consumer": "pnpm -r run test:consumer",
    "test:win": "pnpm -r run test:win"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@kwsites/exec-p": "^0.4.0"
  },
  "packageManager": "pnpm@11.20.0"
}
